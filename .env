# ============================================================
# المحامي الشامل - ملف البيئة
# ============================================================

# قاعدة البيانات (مسار نسبي - يعمل على أي جهاز)
DATABASE_URL=file:./db/custom.db

# ============================================================
# إعدادات مزود الذكاء الاصطناعي (OpenAI-compatible)
# يمكن تعبئتها هنا أو من واجهة الإعدادات داخل النظام
# ============================================================
AI_PROVIDER_BASE_URL=https://api.freemodel.dev/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-5.5

# ============================================================
# إعدادات تليجرام (اختياري - تُضاف من واجهة الإعدادات)
# ============================================================
TELEGRAM_BOT_TOKEN=
